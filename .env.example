# Copy to .env and fill in. Every value below is a placeholder.

# --- Core -----------------------------------------------------------------
# IANA timezone for timestamps, "today" and deadlines (default UTC).
GATEWAY_TIMEZONE=UTC
# Prefix for outbound subjects (default "[Gateway]"; empty for none).
GATEWAY_SUBJECT_PREFIX=[Gateway]
# Spreadsheet that backs the GoogleSheetsStore.
GATEWAY_SHEET_ID=your-spreadsheet-id
# Path to a service-account key file, or the key JSON inline.
GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json

# --- Classifier -----------------------------------------------------------
ANTHROPIC_API_KEY=your-api-key
ANTHROPIC_MODEL=your-primary-model-id
# Second-pass model; empty means the primary model is reused.
ANTHROPIC_FALLBACK_MODEL=
CLASSIFIER_CONFIDENCE_THRESHOLD=0.65
# Defaults to prompts/classifier.md in the repository.
CLASSIFIER_PROMPT_PATH=

# --- Gmail ----------------------------------------------------------------
# Mailbox the service account impersonates (domain-wide delegation with
# gmail.modify, gmail.send and spreadsheets scopes).
GMAIL_USER=gateway@example.com
GMAIL_PUBSUB_TOPIC=projects/your-project/topics/your-topic
# Comma-separated label IDs to watch.
GMAIL_WATCH_LABEL_IDS=INBOX
